{
  "layer": "top",
  "position": "bottom",
  "modules-right": ["network", "backlight", "battery", "pulseaudio", "clock" ],
  "modules-left": ["hyprland/workspaces"],

  "hyprland/workspaces":{
    "format": "{name}"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": " {icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 5
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M} "
  },


  "battery": {
    "format": " {icon} {capacity}%",
    "format-charging": " 󰂄 {capacity}%",
    "format-plugged": " 󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "network": {
    "format-wifi": "{icon}  {essid}",
    "format-disconnected": "󰖪  Network down",
    "format-icons": {
      "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"]
    }
  },

  "pulseaudio": {
    "format": " {icon} {volume}% ",
    "format-muted": " 󰖁 0% ",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5
  }
}
